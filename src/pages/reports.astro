---
import Layout from '../layouts/Layout.astro';
import { DashboardLayout } from '../components/layout/DashboardLayout';
import { ReportsPage } from '../components/pages/ReportsPage';
import { validateSessionToken, getUser } from '../lib/auth';

export const prerender = false;

const sessionToken = Astro.cookies.get('session')?.value;
let user = null;

if (sessionToken) {
  const session = await validateSessionToken(sessionToken);
  if (session) {
    user = getUser(session.userId) || null;
  }
}

if (!user) {
  return Astro.redirect('/signin', 302);
}
---

<Layout title="Reports - InsightAI" user={user}>
  <DashboardLayout currentPage="reports">
    <ReportsPage client:load />
  </DashboardLayout>
</Layout>