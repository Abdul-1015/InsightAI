# InsightAI - Environment Variables
# Copy this to .env and fill in your values

# Base URL for OAuth callbacks
SITE_URL=http://localhost:4321

# Session secret (generate a random string, e.g. openssl rand -base64 32)
SESSION_SECRET=my secret

# Google OAuth credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=googleid
GOOGLE_CLIENT_SECRET=GoogleSecret

# PostgreSQL connection string
# Example: postgres://user:password@localhost:5432/ai_analysis_tool
DATABASE_URL=postgres://user:password@localhost:5432/ai_analysis_tool

